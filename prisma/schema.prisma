// Rawaes — project & task tracking.
//
// Nothing here has been applied to any server. This is the schema file only;
// generating a migration and running it is a separate, deliberate step.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ── Roles ───────────────────────────────────────────────────────────────────

/// Account-wide role. SUPER_ADMIN oversees every project; MANAGER and MEMBER
/// only reach the projects they are joined to via ProjectMember.
enum UserRole {
  SUPER_ADMIN
  MANAGER
  MEMBER
}

/// A user's role *on one specific project*. Someone can manage one project and
/// merely take part in another, so this lives on the membership, not the user.
enum ProjectRole {
  MANAGER
  MEMBER
}

// ── Enumerated states ───────────────────────────────────────────────────────

/// Stored as stable identifiers; the Arabic labels (تخطيط / قائم / متعطل /
/// مكتمل) are presentation and live in the UI layer.
enum ProjectStatus {
  PLANNING
  ACTIVE
  BLOCKED
  DONE
}

/// Board columns, in order: جديد / قيد التنفيذ / مراجعة / مكتمل
enum TaskStage {
  NEW
  IN_PROGRESS
  REVIEW
  DONE
}

/// Task lifecycle approval state.
/// PENDING_APPROVAL → (super-admin approves) → ACTIVE
/// ACTIVE → (assignee requests completion) → PENDING_COMPLETION
/// PENDING_COMPLETION → (manager approves) → DONE
/// PENDING_COMPLETION → (manager rejects) → ACTIVE
/// PENDING_APPROVAL → (super-admin rejects) → REJECTED
enum TaskApprovalStatus {
  PENDING_APPROVAL
  ACTIVE
  PENDING_COMPLETION
  DONE
  REJECTED
}

// ── Models ──────────────────────────────────────────────────────────────────

model User {
  id    String @id @default(cuid())
  name  String
  email String @unique

  /// bcrypt hash. Null means the account cannot sign in with a password yet —
  /// an invited user who has not set one. Never selected into anything that
  /// reaches the client.
  passwordHash String?

  role       UserRole @default(MEMBER)
  department String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  memberships      ProjectMember[]
  ownedProjects     Project[]      @relation("ProjectOwner")
  assignedTasks     Task[]         @relation("TaskAssignee")
  addedTasks        Task[]         @relation("TaskAddedBy")
  assignedSubtasks  Subtask[]      @relation("SubtaskAssignee")
  addedSubtasks     Subtask[]      @relation("SubtaskAddedBy")
  dailyTasks        DailyTask[]    @relation("DailyTaskOwner")
  addedDailyTasks   DailyTask[]    @relation("DailyTaskAddedBy")
  activity          ActivityLog[]

  @@map("users")
}

model Project {
  id     String @id @default(cuid())
  name   String
  /// Short line above the name — the batch or category ("دفعة الربع الرابع").
  kicker String?

  department String?
  status     ProjectStatus @default(PLANNING)
  note       String?       @db.Text
  startDate  DateTime?     @db.Date
  dueDate    DateTime?     @db.Date

  /// Optional link to GitHub repository for commits listing (e.g. "https://github.com/owner/repo")
  githubUrl String?

  /// Manually stated completion, 0–100, read only while the project has no
  /// tasks. Adding the first one hands the percentage back to the count and
  /// leaves this ignored — it never overrides a real tally. It carries imported
  /// projects whose history was never entered as tasks, which would otherwise
  /// read 0%.
  progressPct Int?

  /// The single accountable owner shown as "المسؤول" in the projects table.
  /// Held alongside ProjectMember (not instead of it): this is the one name on
  /// the row, while memberships carry the full team and their per-project roles.
  /// An owner is expected to also hold a MANAGER membership — enforce that in
  /// application code, since the database cannot express it.
  ownerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User?           @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  members  ProjectMember[]
  tasks    Task[]
  activity ActivityLog[]

  @@index([status])
  @@index([ownerId])
  @@map("projects")
}

/// Join table: a user may sit on many projects, a project holds many users.
/// The project's manager is the membership whose role is MANAGER.
model ProjectMember {
  id        String      @id @default(cuid())
  userId    String
  projectId String
  role      ProjectRole @default(MEMBER)
  joinedAt  DateTime    @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId, role])
  @@map("project_members")
}

model Task {
  id        String @id @default(cuid())
  projectId String
  title     String

  /// No longer the source of truth for the board column — that is derived from
  /// `approvalStatus` by `stageFor`, so the two can never disagree. The writes
  /// below it in app/actions.ts are kept only so the stored value stays honest
  /// for anyone reading the table directly; nothing in the app reads it. Safe
  /// to drop.
  stage TaskStage @default(NEW)

  /// Manual ordering inside a board column.
  position Int @default(0)

  assigneeId String?

  /// Who added this task (manager or member).
  addedById String?

  /// Approval lifecycle state.
  approvalStatus TaskApprovalStatus @default(PENDING_APPROVAL)

  /// Optional note from the assignee when they request completion.
  completionNote String? @db.Text

  /// Why the manager admitted this task, or turned it away. Carries the reason
  /// whichever way the first decision went — a rejection must give one, an
  /// admission may.
  reviewNote String? @db.Text

  /// The same, for the second decision: signing off the completion or sending
  /// it back. Kept apart from `reviewNote` so admitting a task cannot erase why
  /// its completion was refused, nor the other way round.
  completionReviewNote String? @db.Text

  /// When the assignee marked this task as complete (requested completion).
  completionRequestedAt DateTime?

  /// When the manager approved the completion.
  managerApprovedAt DateTime?

  /// Set when the task first leaves NEW; cleared if it is sent back.
  startedAt DateTime?
  /// Set only when the task reaches DONE after manager approval.
  completedAt DateTime?

  /// Optional planned start date for this specific task.
  startDate DateTime? @db.Date

  /// Optional planned deadline for this specific task.
  dueDate DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  addedBy  User?     @relation("TaskAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  subtasks Subtask[]

  @@index([projectId, stage, position])
  @@index([assigneeId])
  @@index([addedById])
  @@index([approvalStatus])
  @@index([startedAt])
  @@index([completedAt])
  @@map("tasks")
}

/// One step of a `Task`, carrying the same approval lifecycle as its parent.
///
/// A separate table rather than a `parentId` on `Task`, for the reason spelled
/// out on `DailyTask` below: every percentage, tally and calendar entry in this
/// schema reads `Task` rows directly — `toProjectView`, `userCardSelect`,
/// `movementsOf`, the board columns, the due-date reminders. A self-relation
/// would silently fold steps into all of them as if they were tasks in their own
/// right, and each one would have to be taught to filter `parentId: null` by
/// hand. A step is a part of a task, not another task, so it gets its own table
/// and the counts stay honest.
///
/// The lifecycle is the same `TaskApprovalStatus` and the same gates as `Task`
/// (see lib/permissions), with one addition that runs the other way: a parent
/// task cannot be sent for completion while any of its steps is still open.
model Subtask {
  id     String @id @default(cuid())
  taskId String
  title  String

  /// Manual ordering within the parent task.
  position Int @default(0)

  /// Who carries this step. Null means it falls to whoever holds the parent.
  assigneeId String?

  /// Who wrote it down.
  addedById String?

  approvalStatus TaskApprovalStatus @default(PENDING_APPROVAL)

  /// Optional note from the assignee when they request completion.
  completionNote String? @db.Text

  /// Reasons behind the two decisions, as on `Task` — see the notes there.
  reviewNote           String? @db.Text
  completionReviewNote String? @db.Text

  completionRequestedAt DateTime?
  managerApprovedAt     DateTime?

  /// Set when the step is admitted; cleared if it is sent back.
  startedAt DateTime?
  /// Set only once the completion is approved.
  completedAt DateTime?

  /// Optional deadline for this step alone. There is no `startDate` to match
  /// `Task`: the parent already carries the planned window, and a step needs at
  /// most a date it is owed by.
  dueDate DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task     Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignee User? @relation("SubtaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  addedBy  User? @relation("SubtaskAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@index([taskId, position])
  @@index([assigneeId])
  @@index([addedById])
  @@index([approvalStatus])
  @@map("subtasks")
}

/// Day-to-day work that hangs off a person rather than a project — the errands
/// and small jobs that would otherwise have no home on the board.
///
/// Deliberately not a `Task` with a null `projectId`: every query, percentage
/// and activity entry in this schema reads a task through its project, and a
/// project-less row would have to be excluded from each one by hand. A separate
/// table keeps those calculations honest and lets this one carry the fields a
/// daily task actually needs.
///
/// The approval lifecycle is the same `TaskApprovalStatus` as `Task`, but the
/// gates differ: there is no ProjectMember to consult, so a super admin both
/// admits the task and signs off its completion. See lib/permissions.
model DailyTask {
  id    String  @id @default(cuid())
  title String
  note  String? @db.Text

  /// The person carrying the task. Required, unlike `Task.assigneeId` — a daily
  /// task nobody owns has nothing to sit under.
  ownerId String

  /// Who wrote it down. Usually the owner; a super admin may hand one out.
  addedById String?

  /// The calendar day this is planned for. This is what makes the task
  /// "daily" — the tab groups on it and the calendar places the bar by it.
  day DateTime @db.Date

  approvalStatus TaskApprovalStatus @default(PENDING_APPROVAL)

  /// Optional note from the owner when they request completion.
  completionNote String? @db.Text

  /// Reasons behind the two decisions, as on `Task` — see the notes there.
  reviewNote           String? @db.Text
  completionReviewNote String? @db.Text

  completionRequestedAt DateTime?
  /// When the super admin signed off the completion.
  managerApprovedAt     DateTime?

  /// Set when the task is admitted to the list; cleared if it is turned away.
  startedAt DateTime?
  /// Set only once the completion is approved.
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User  @relation("DailyTaskOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  addedBy User? @relation("DailyTaskAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@index([ownerId, day])
  @@index([approvalStatus])
  @@index([day])
  @@map("daily_tasks")
}

/// Append-only feed behind "آخر التحديثات".
model ActivityLog {
  id        String  @id @default(cuid())
  projectId String
  /// Null when the entry was written by the system rather than a person.
  userId    String?
  message   String  @db.Text
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@map("activity_log")
}
